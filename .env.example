# FreeCAD Version Configuration
# ==============================
# Configure paths to different FreeCAD installations for testing.

# FreeCAD 1.1 (stable)
FREECAD_1_1_CMD="/home/akshi/opencode-tmp/freecad-1.1-rootfs/AppRun"

# FreeCAD LinkBranch (development)
FREECAD_LINK_CMD="/home/akshi/opencode-tmp/freecad-link-root/AppRun"

# Default FreeCAD version to use when --freecad flag is not specified
# Options: 1.1, link, all
FREECAD_VERSION="1.1"

# Legacy Variables (for backward compatibility)
# =============================================
# These are still supported but the version-specific vars above are preferred.

# Single FreeCAD command (used if version-specific commands not available)
# FREECAD_CMD="/path/to/FreeCAD/AppRun"

# Space-separated list of FreeCAD commands for integration tests
# FREECAD_CMDS="/path/to/FreeCAD1/AppRun /path/to/FreeCAD2/AppRun"

# FreeCAD GUI command (used for GUI tests if version-specific not available)
# FREECAD_GUI_CMD="/path/to/FreeCAD/AppRun"
